#!/bin/bash
# Server health check — runs every 3 hours
# Posts CPU, RAM, disk, network, containers to Discord
set -euo pipefail

WEBHOOK="{{ discord_webhook | default('') }}"
[ -z "$WEBHOOK" ] && exit 0

# ── Collect metrics ──────────────────────────────────────────

# CPU
CPU_LOAD=$(uptime | awk -F'load average:' '{print $2}' | xargs)
CPU_CORES=$(nproc)
# CPU usage from /proc/stat (average over all cores)
read CPU_A CPU_B < <(grep '^cpu ' /proc/stat | awk '{print $2+$3+$4, $2+$3+$4+$5+$6+$7+$8}')
sleep 1
read CPU_C CPU_D < <(grep '^cpu ' /proc/stat | awk '{print $2+$3+$4, $2+$3+$4+$5+$6+$7+$8}')
CPU_PCT=$(( 100 * (CPU_C - CPU_A) / (CPU_D - CPU_B) ))
[ "$CPU_PCT" -gt 100 ] && CPU_PCT=100

# RAM
RAM_TOTAL=$(free -h | awk 'NR==2{print $2}')
RAM_USED=$(free -h | awk 'NR==2{print $3}')
RAM_PCT=$(free | awk 'NR==2{printf "%.0f", $3/$2*100}')
SWAP_TOTAL=$(free -h | awk 'NR==3{print $2}')
SWAP_USED=$(free -h | awk 'NR==3{print $3}')

# Disk
DISK_ROOT=$(df -h / | awk 'NR==2{print $3"/"$2" ("$5")"}')
DISK_ROOT_PCT=$(df / | awk 'NR==2{print $5}' | tr -d '%')

# Network (aggregate all interfaces)
RX_BYTES=$(awk '/:/ && !/lo:/ {rx+=$2} END {printf "%.1f MB", rx/1048576}' /proc/net/dev)
TX_BYTES=$(awk '/:/ && !/lo:/ {tx+=$10} END {printf "%.1f MB", tx/1048576}' /proc/net/dev)

# Uptime
UP=$(uptime -p | sed 's/up //')

# Containers
TOTAL_CT=$(docker ps -q | wc -l)
UNHEALTHY=$(docker ps --filter "health=unhealthy" --format "table {% raw %}{{.Names}}{% endraw %}" | tail -n +2 | tr '\n' ' ')
RESTARTING=$(docker ps --filter "status=restarting" --format "table {% raw %}{{.Names}}{% endraw %}" | tail -n +2 | tr '\n' ' ')
DEAD_CT=$(docker ps -a --filter "status=exited" -q | wc -l)

# Backups
DB_BACKUPS=$(ls /opt/backup/database/*.gz 2>/dev/null | wc -l)
VOL_BACKUPS=$(ls /opt/backup/volumes/*.tar.gz 2>/dev/null | wc -l)
LAST_BACKUP=$(ls -t /opt/backup/database/*.gz 2>/dev/null | head -1 | xargs -I{} basename {} .sql.gz | sed 's/espocrm_//' || echo "none")

# SSL certs
CERT_COUNT=$(python3 -c "
import json
d=json.load(open('/opt/traefik/letsencrypt/acme.json'))
print(len(d['letsencrypt']['Certificates']))
" 2>/dev/null || echo "0")

# Top CPU processes
TOP_PROCS=$(ps aux --sort=-%cpu | head -4 | tail -3 | awk '{print $11" ("$3"% CPU)"}' | tr '\n' ' | ')

# ── Determine health ──────────────────────────────────────────

ISSUES=""
[ -n "$UNHEALTHY" ] && ISSUES="${ISSUES}Unhealthy containers: $UNHEALTHY\n"
[ -n "$RESTARTING" ] && ISSUES="${ISSUES}Restarting: $RESTARTING\n"
[ "$DISK_ROOT_PCT" -gt 85 ] && ISSUES="${ISSUES}Disk usage critical: ${DISK_ROOT_PCT}%\n"
[ "$RAM_PCT" -gt 90 ] && ISSUES="${ISSUES}RAM usage critical: ${RAM_PCT}%\n"

if [ -n "$ISSUES" ]; then
  COLOR=16711680  # Red
  TITLE="🖥️ VPS CRITICAL"
  ISSUE_FIELD=",\"name\":\"Issues\",\"value\":\"$ISSUES\",\"inline\":false"
else
  COLOR=3447003   # Blue
  TITLE="🖥️ VPS Health"
  ISSUE_FIELD=""
fi

# ── Post to Discord ───────────────────────────────────────────

curl -s -X POST "$WEBHOOK" -H "Content-Type: application/json" -d "{
  \"embeds\": [{
    \"title\": \"$TITLE\",
    \"color\": $COLOR,
    \"fields\": [
      {\"name\":\"CPU\",\"value\":\"Load: $CPU_LOAD\\nUsage: ${CPU_PCT}% ($CPU_CORES cores)\",\"inline\":true},
      {\"name\":\"RAM\",\"value\":\"$RAM_USED / $RAM_TOTAL ($RAM_PCT%)\nSwap: $SWAP_USED / $SWAP_TOTAL\",\"inline\":true},
      {\"name\":\"Disk\",\"value\":\"Root: $DISK_ROOT\nDB backups: $DB_BACKUPS | Vol: $VOL_BACKUPS\",\"inline\":true},
      {\"name\":\"Network\",\"value\":\"RX: $RX_BYTES | TX: $TX_BYTES\",\"inline\":true},
      {\"name\":\"Uptime\",\"value\":\"$UP\",\"inline\":true},
      {\"name\":\"Certificates\",\"value\":\"$CERT_COUNT active\",\"inline\":true},
      {\"name\":\"Containers\",\"value\":\"$TOTAL_CT running, $DEAD_CT stopped\",\"inline\":true},
      {\"name\":\"Last Backup\",\"value\":\"$LAST_BACKUP\",\"inline\":true},
      {\"name\":\"Top CPU\",\"value\":\"$TOP_PROCS\",\"inline\":false}
      $ISSUE_FIELD
    ],
    \"footer\": {\"text\": \"VPS Cron | every 3h | $UP uptime\"},
    \"timestamp\": \"$(date -u +%Y-%m-%dT%H:%M:%SZ)\"
  }]
}"
